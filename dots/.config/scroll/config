# Scroll test session: port of ~/.config/hypr/hyprland.lua + monitors.lua (2026-11-01).
# Build: ~/Projects/scroll, branch hdr-sdr-nits (adds the `sdr_nits` command).
# HDR needs WLR_RENDERER=vulkan, set in ~/.config/uwsm/env-scroll.

set $mod Mod4
set $app uwsm app --
set $term kitty
set $filemanager thunar
set $browser helium-browser

# 240Hz, not 360: 360Hz 10-bit HDR uses ~98.7% of DP 1.4 bandwidth (see monitors.lua).
# adaptive_sync fullscreen comes from the local patch, older builds read it as off.
output DP-1 {
    mode 1920x1080@240Hz
    position 0 0
    scale 1
    adaptive_sync fullscreen
    allow_tearing yes
    render_bit_depth 10
    hdr on
}

### Look and feel
default_border pixel 2
default_floating_border pixel 2
gaps inner 4
gaps outer 8
default_decoration border_radius 10 shadow true shadow_dynamic false shadow_size 4 shadow_blur 3 shadow_offset 0 0 shadow_color #1a1a1aee dim false
client.focused          #89b4fa #1e1e2e #e0e0e0 #89b4fa #89b4fa
client.focused_inactive #595959 #1e1e2e #e0e0e0 #595959 #595959
client.unfocused        #595959 #1e1e2e #e0e0e0 #595959 #595959

# Tiling like ii's Hyprland dwindle (11/9, replaced the niri-like strip): no scrolling,
# every window fits on screen, a new window splits the focused one in half.
# Scroll only splits sideways; Super+Shift+Up/Down stacks a window into a column.
layout_default_mode h fitsplit
# OFF on purpose (11/9): with fitsplit, maximize_if_single true makes every new window
# 0.1% wide (invisible). fitsplit already fills the screen with one window and re-expands on close.
maximize_if_single false
# Box/grid tiling (11/9): before each new window, split the focused window along its longer side
# (wide -> new column beside it, tall -> stacked below it). Same idea as Hyprland dwindle.
lua ~/.config/scroll/autosplit.lua
focus_wrapping no

focus_follows_mouse yes
focus_on_window_activation focus
seat seat0 xcursor_theme capitaine-cursors 24

# Plasma-like speed, same outCubic curve as Hyprland
animations {
    enabled yes
    style scale
    default yes 150 var simple [ 0.33 1 0.68 1 ]
    window_open yes 100 var simple [ 0.33 1 0.68 1 ]
    window_move yes 150 var simple [ 0.33 1 0.68 1 ]
    window_size yes 150 var simple [ 0.33 1 0.68 1 ]
    window_fullscreen yes 150 var simple [ 0.33 1 0.68 1 ]
    workspace_switch yes 150 var simple [ 0.33 1 0.68 1 ]
    overview yes 150 var simple [ 0.33 1 0.68 1 ]
    jump yes 150 var simple [ 0.33 1 0.68 1 ]
    layer_shell yes 100 var simple [ 0.33 1 0.68 1 ]
    fade_in yes 100 var simple [ 0.33 1 0.68 1 ]
    fade_out yes 100 var simple [ 0.33 1 0.68 1 ]
}

### Input
input type:keyboard {
    xkb_layout us
    repeat_delay 250
    repeat_rate 40
}
input type:pointer {
    accel_profile flat
    pointer_accel 0
}
input "1133:16553:Logitech_PRO_X_2" {
    accel_profile flat
    pointer_accel 1.0
}

# Window/workspace binds follow end-4 ii's keybinds.lua (dwindle) since 11/9; ii-only
# shell binds live in shell-ii.conf. "### X" / "#! text" feed ii's cheatsheet (Super+/).

### Apps
#! Terminal
bindsym $mod+Return exec $app $term
bindsym $mod+t exec $app $term
bindsym Ctrl+Alt+t exec $app $term
#! File manager
bindsym $mod+e exec $app $filemanager
#! Browser
bindsym $mod+w exec $app $browser
#! Code editor
bindsym $mod+c exec $app zeditor
#! Volume mixer
bindsym Ctrl+$mod+v exec $app pavucontrol
#! Task manager
bindsym Ctrl+Shift+Escape exec $app kitty -1 btop
# Shell binds (ii), via the shell.conf symlink -> shell-ii.conf
include ~/.config/scroll/shell.conf
bindsym Ctrl+Alt+r exec ~/.local/bin/gsr-toggle.sh
bindsym $mod+Shift+e exec uwsm stop
bindsym $mod+Shift+c reload

# VRR toggle, HDR SDR white 80-480 nits (state shared with ii's slider via the ddcutil shim)
bindsym $mod+F12 output DP-1 adaptive_sync toggle; exec notify-send VRR 'Adaptive Sync toggled'
bindsym $mod+F2 exec scroll-sdr-nits down
bindsym $mod+F3 exec scroll-sdr-nits up

### Window
#! Focus in direction
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down
bindsym $mod+bracketleft focus left
bindsym $mod+bracketright focus right
#! Move in direction
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down
#! Close
bindsym $mod+q kill
#! Forcefully zap a window
bindsym $mod+Shift+Alt+q exec sh -c 'kill -9 "$(scrollmsg -t get_tree | jq ".. | objects | select(.focused? == true) | .pid")"'
#! Adjust split ratio
bindsym $mod+semicolon resize shrink width 10 ppt
bindsym $mod+apostrophe resize grow width 10 ppt
#! Float/Tile
bindsym $mod+Alt+space floating toggle
#! Maximize
bindsym $mod+d toggle_size this 1.0 1.0
#! Fullscreen
bindsym $mod+f fullscreen
#! Fullscreen spoof
bindsym $mod+Alt+f fullscreen toggle application
#! Pin (floating windows)
bindsym $mod+p sticky toggle
#! Send to workspace 1-10 (stay)
bindsym $mod+Alt+1 move container to workspace number 1
bindsym $mod+Alt+2 move container to workspace number 2
bindsym $mod+Alt+3 move container to workspace number 3
bindsym $mod+Alt+4 move container to workspace number 4
bindsym $mod+Alt+5 move container to workspace number 5
bindsym $mod+Alt+6 move container to workspace number 6
bindsym $mod+Alt+7 move container to workspace number 7
bindsym $mod+Alt+8 move container to workspace number 8
bindsym $mod+Alt+9 move container to workspace number 9
bindsym $mod+Alt+0 move container to workspace number 10
#! Send to workspace left/right
bindsym $mod+Shift+Page_Up move container to workspace prev_on_output
bindsym $mod+Shift+Page_Down move container to workspace next_on_output
bindsym $mod+Alt+Page_Up move container to workspace prev_on_output
bindsym $mod+Alt+Page_Down move container to workspace next_on_output
bindsym Ctrl+$mod+Shift+Left move container to workspace prev_on_output
bindsym Ctrl+$mod+Shift+Right move container to workspace next_on_output
bindsym --whole-window $mod+Shift+button4 move container to workspace prev_on_output
bindsym --whole-window $mod+Shift+button5 move container to workspace next_on_output
bindsym --whole-window $mod+Alt+button4 move container to workspace prev_on_output
bindsym --whole-window $mod+Alt+button5 move container to workspace next_on_output
#! Send to scratchpad
bindsym $mod+Alt+s move scratchpad
# Super + left-drag = move, Super + right-drag = resize
floating_modifier $mod normal

### Workspace
#! Focus workspace 1-10
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
#! Move window and follow it (not in upstream)
bindsym $mod+Shift+1 move container to workspace number 1; workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2; workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3; workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4; workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5; workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6; workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7; workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8; workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9; workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10; workspace number 10
#! Focus left/right
bindsym Ctrl+$mod+Left workspace prev_on_output
bindsym Ctrl+$mod+Right workspace next_on_output
bindsym $mod+Page_Up workspace prev_on_output
bindsym $mod+Page_Down workspace next_on_output
bindsym Ctrl+$mod+Page_Up workspace prev_on_output
bindsym Ctrl+$mod+Page_Down workspace next_on_output
bindsym Ctrl+$mod+bracketleft workspace prev_on_output
bindsym Ctrl+$mod+bracketright workspace next_on_output
bindsym --whole-window $mod+button5 workspace next_on_output
bindsym --whole-window $mod+button4 workspace prev_on_output
#! Toggle scratchpad
bindsym $mod+s scratchpad show
bindsym Ctrl+$mod+s scratchpad show
bindsym --whole-window $mod+button8 scratchpad show
#! Dropdown terminal
bindsym $mod+grave exec ~/.config/scroll/dropterm

### Session
#! Sleep
bindsym --locked $mod+Shift+l exec systemctl suspend
#! Shut down
bindsym Ctrl+Shift+Alt+$mod+Delete exec systemctl poweroff

### Media
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPrev exec playerctl previous
#! Toggle mute
bindsym --locked $mod+Shift+m exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
#! Toggle mic
bindsym --locked $mod+Alt+m exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked Alt+XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
#! Next track
bindsym --locked $mod+Shift+n exec playerctl next
#! Previous track
bindsym --locked $mod+Shift+b exec playerctl previous
#! Play/pause media
bindsym --locked $mod+Shift+p exec playerctl play-pause

### Window rules
for_window [app_id="^nm-openconnect-auth-dialog$"] floating enable
for_window [class="^nm-openconnect-auth-dialog$"] floating enable
for_window [app_id="^[Ss]team$"] floating enable
for_window [class="^[Ss]team$"] floating enable
# Dip to this opacity for this many ms on keyboard focus changes, `focus_flash off` to disable.
focus_flash 0.85 150
# Each pass doubles the blur size, 0 disables it. Clients can ask for blur themselves (ext-background-effect).
blur_passes 2
# size contrast brightness vibrancy noise, same values and shader as Hyprland
blur_style 5 0.8916 0.8172 0.1696 0.0117
# Only translucent pixels get blurred, opaque windows cost nothing.
for_window [all] window_blur on
# Blur showed up on Helium's address bar (11/2).
for_window [app_id="^helium$"] window_blur off
# Same for Google Chrome (11/4).
for_window [app_id="^[Gg]oogle-chrome$"] window_blur off
for_window [class="^[Gg]oogle-chrome$"] window_blur off
for_window [app_id="^xdpw-chooser$"] floating enable
# Scroll drops the corner radius on client-side decorated windows, so use its own border everywhere.
for_window [all] border pixel 2

# Steam games: real fullscreen for VRR, tearing allowed, no idle-off mid-game
for_window [app_id="^steam_app_[0-9]+$"] fullscreen enable, allow_tearing yes, inhibit_idle fullscreen, window_blur off
for_window [class="^steam_app_[0-9]+$"] fullscreen enable, allow_tearing yes, inhibit_idle fullscreen, window_blur off

for_window [app_id="^[Ss]potify$"] opacity 0.85
for_window [class="^[Ss]potify$"] opacity 0.85

for_window [app_id="^kitty-dropterm$"] floating enable, move scratchpad

assign [app_id="^rdp-l531$"] workspace number 5
assign [class="^rdp-l531$"] workspace number 5
assign [app_id="^[Gg]oogle-chrome$"] workspace number 4
assign [class="^[Gg]oogle-chrome$"] workspace number 4

exec ~/.config/scroll/autostart
