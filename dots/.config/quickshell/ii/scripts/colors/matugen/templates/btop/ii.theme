# ii (matugen) btop theme, adapted from caelestia-dots/cli's btop template.
# Generated by ii's switchwall.sh; edit the template, not the output.
# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]={{colors.surface.default.hex}}

# Main text color
theme[main_fg]={{colors.on_surface.default.hex}}

# Title color for boxes
theme[title]={{colors.on_surface.default.hex}}

# Highlight color for keyboard shortcuts
theme[hi_fg]={{colors.primary.default.hex}}

# Background color of selected item in processes box
theme[selected_bg]={{colors.surface_container.default.hex}}

# Foreground color of selected item in processes box
theme[selected_fg]={{colors.primary.default.hex}}

# Color of inactive/disabled text
theme[inactive_fg]={{colors.outline.default.hex}}

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]={{colors.tertiary.default.hex}}

# Background color of the percentage meters
theme[meter_bg]={{colors.outline.default.hex}}

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]={{colors.tertiary.default.hex}}

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]={{colors.mauve.default.hex}}
theme[mem_box]={{colors.green.default.hex}}
theme[net_box]={{colors.maroon.default.hex}}
theme[proc_box]={{colors.blue.default.hex}}

# Box divider line and small boxes line color
theme[div_line]={{colors.outline_variant.default.hex}}

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]={{colors.green.default.hex}}
theme[temp_mid]={{colors.yellow.default.hex}}
theme[temp_end]={{colors.red.default.hex}}

# CPU graph colors (Teal -> Sapphire -> Lavender)
theme[cpu_start]={{colors.teal.default.hex}}
theme[cpu_mid]={{colors.sapphire.default.hex}}
theme[cpu_end]={{colors.lavender.default.hex}}

# Mem/Disk free meter (Mauve -> Lavender -> Blue)
theme[free_start]={{colors.mauve.default.hex}}
theme[free_mid]={{colors.lavender.default.hex}}
theme[free_end]={{colors.blue.default.hex}}

# Mem/Disk cached meter (Sapphire -> Blue -> Lavender)
theme[cached_start]={{colors.sapphire.default.hex}}
theme[cached_mid]={{colors.blue.default.hex}}
theme[cached_end]={{colors.lavender.default.hex}}

# Mem/Disk available meter (Peach -> Maroon -> Red)
theme[available_start]={{colors.peach.default.hex}}
theme[available_mid]={{colors.maroon.default.hex}}
theme[available_end]={{colors.red.default.hex}}

# Mem/Disk used meter (Green -> Teal -> Sky)
theme[used_start]={{colors.green.default.hex}}
theme[used_mid]={{colors.teal.default.hex}}
theme[used_end]={{colors.sky.default.hex}}

# Download graph colors (Peach -> Maroon -> Red)
theme[download_start]={{colors.peach.default.hex}}
theme[download_mid]={{colors.maroon.default.hex}}
theme[download_end]={{colors.red.default.hex}}

# Upload graph colors (Green -> Teal -> Sky)
theme[upload_start]={{colors.green.default.hex}}
theme[upload_mid]={{colors.teal.default.hex}}
theme[upload_end]={{colors.sky.default.hex}}

# Process box color gradient for threads, mem and cpu usage (Sapphire -> Lavender -> Mauve)
theme[process_start]={{colors.sapphire.default.hex}}
theme[process_mid]={{colors.lavender.default.hex}}
theme[process_end]={{colors.mauve.default.hex}}
