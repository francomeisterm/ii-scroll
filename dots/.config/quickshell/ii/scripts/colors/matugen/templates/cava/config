# cava config with ii (matugen) colors; gradient adapted from caelestia-dots/cli.
# Generated by ii's switchwall.sh; edit the template, not the output.
# (ii's own media-controls visualizer uses its own config, not this file.)

[general]
framerate = 60

[input]
method = pulse
source = auto

[output]
method = ncurses
style = stereo

[color]
gradient = 1
gradient_count = 8
gradient_color_1 = '{{colors.green.default.hex}}'
gradient_color_2 = '{{colors.teal.default.hex}}'
gradient_color_3 = '{{colors.sky.default.hex}}'
gradient_color_4 = '{{colors.sapphire.default.hex}}'
gradient_color_5 = '{{colors.blue.default.hex}}'
gradient_color_6 = '{{colors.lavender.default.hex}}'
gradient_color_7 = '{{colors.mauve.default.hex}}'
gradient_color_8 = '{{colors.maroon.default.hex}}'

[smoothing]
noise_reduction = 85
monstercat = 1
waves = 0
gravity = 120
