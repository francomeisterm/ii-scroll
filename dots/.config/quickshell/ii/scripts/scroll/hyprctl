#!/usr/bin/env bash
# Scroll port: minimal `hyprctl` stand-in for ii's shell scripts (NOT put on the global
# PATH; scripts prepend this dir themselves). Supports what the scripts call:
#   hyprctl monitors -j      -> scrollmsg get_outputs, reshaped like Hyprland's JSON
#   hyprctl cursorpos [-j]   -> centre of the focused output (sway IPC has no cursor position)
set -euo pipefail
args=" $* "
outputs() {
    scrollmsg -r -t get_outputs | jq '[.[] | select(.active != false) | {
        id: 0, name, x: .rect.x, y: .rect.y,
        width: ((.rect.width * .scale) | round), height: ((.rect.height * .scale) | round),
        scale, focused, activeWorkspace: {name: .current_workspace}
    }] | to_entries | map(.value.id = .key | .value)'
}
case "$args" in
    *" monitors "*) outputs ;;
    *" cursorpos "*)
        read -r x y < <(outputs | jq -r '(map(select(.focused)) + .)[0] | "\(.x + (.width / .scale / 2 | floor)) \(.y + (.height / .scale / 2 | floor))"')
        if [[ $args == *" -j "* ]]; then printf '{"x": %s, "y": %s}\n' "$x" "$y"; else echo "$x, $y"; fi ;;
    *) echo "hyprctl (scroll shim): unsupported: $*" >&2; exit 1 ;;
esac
